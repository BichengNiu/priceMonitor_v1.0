# Python and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.coverage
htmlcov/

# Local virtual environments and build caches
.venv/
.build-venv/
.build/

# User-facing Stata exports stay local; the DuckDB panel is tracked with Git LFS.
data/*.dta

# Legacy local checkpoint is ignored and is no longer read by the collector.
data/state.json

# Temporary/editor files
*.tmp
*.temp
*.bak
*.swp
*~
